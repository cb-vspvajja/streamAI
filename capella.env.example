# Fill in these eight values, then run: bash START-CAPELLA.sh
# Use single quotes around passwords/keys so $ and spaces stay literal.
CB_CONN_STRING=couchbases://CHANGE_ME_CLUSTER_SDK_HOST
CB_USERNAME=CHANGE_ME_DATABASE_USERNAME
CB_PASSWORD='CHANGE_ME_DATABASE_PASSWORD'
MCP_CB_USERNAME=CHANGE_ME_READ_ONLY_USERNAME
MCP_CB_PASSWORD='CHANGE_ME_READ_ONLY_PASSWORD'
CHAT_BASE_URL=https://CHANGE_ME_CHAT_ENDPOINT_ROOT
EMBEDDING_BASE_URL=https://CHANGE_ME_EMBEDDING_ENDPOINT_ROOT
CAPELLA_MODEL_API_KEY='CHANGE_ME_MODEL_INFERENCE_KEY'

# Save the Capella cluster's downloaded root CA at certs/capella-ca.pem.
# Defaults use one database credential with Read/Write on streaming and
# agent_memory for this demo. MCP uses the separate read-only credential above.

# Optional: richer catalogue. The first start defaults to six fictional titles.
LOAD_SAMPLE_CATALOGUE=true
TMDB_READ_ACCESS_TOKEN=

# Optional full-AIDP extensions: enable only after provisioning them in Capella.
# A workflow must vectorize catalogue.titles.embeddingText into embedding,
# using nvidia/llama-3.2-nv-embedqa-1b-v2, passage mode, 2048 dimensions.
AI_FUNCTIONS_ENABLED=false
DATA_PROCESSING_MODE=python_loader
DATA_PROCESSING_WORKFLOW_ID=

# Local UI port; separate from the original demo's default 8088.
CAPELLA_UI_PORT=8089

# Usage events, reporting windows and assumptions are stored in Couchbase.
# Keep the default namespace when upgrading to preserve verified history.
USAGE_LEDGER_ID=streamai
USAGE_UPGRADE_WAIT_SECONDS=120

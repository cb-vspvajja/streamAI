# Self-managed Couchbase Server / EC2 configuration reference
# Copy to .env in the application root for the legacy server scripts.
# Replace database/model endpoints and credentials for your environment.
# Review Docker DNS and TLS configuration before use on Linux or EC2.
# START-CAPELLA.sh reads capella.env instead and does not use this file.
# The v1.1 usage gateway and measured Memory trial need server-launch integration.
# This reference does not provision EC2, Couchbase, model hosting or networking.

# StreamAI v2.0.1 - copy one deployment profile to .env
DEPLOYMENT_TARGET=server
CB_CONN_STRING=couchbases://server.example.internal
# Optional host-side override for tools/load_catalogue.py when runtime/container DNS differs.
CB_LOADER_CONN_STRING=couchbases://server.example.internal
CB_LOADER_CONNECT_ATTEMPTS=4
CB_LOADER_CONNECT_RETRY_DELAY_SECONDS=2
CB_USERNAME=streamai
CB_PASSWORD=streamai123
CB_WAN_PROFILE=true
CB_CONNECT_TIMEOUT_SECONDS=30
SEARCH_TRANSPORT=sdk
CB_SEARCH_URL=http://host.docker.internal:8094
CONTENT_BUCKET=streaming
CATALOGUE_SEARCH_INDEX=streaming-catalogue-search
PLAN_CACHE_SEARCH_INDEX=streaming-plan-cache
PLAN_CACHE_COLLECTION=plan_cache
ASSISTANT_PLANNER_ENABLED=true
ASSISTANT_PLANNER_MODEL_ENABLED=true
ASSISTANT_PLANNER_VERSION=3.1
ASSISTANT_PLANNER_TIMEOUT_SECONDS=2.0
ASSISTANT_TOOL_SCHEMA_VERSION=2.1
PLAN_CACHE_ENABLED=true
PLAN_CACHE_SEMANTIC_ENABLED=true
PLAN_CACHE_SEMANTIC_THRESHOLD=0.92
PLAN_CACHE_SEMANTIC_PROBE_TIMEOUT_SECONDS=0.75
PLAN_CACHE_TTL_SECONDS=2592000
SEARCH_INTERACTIVE_TIMEOUT_SECONDS=1.5
SEARCH_CIRCUIT_BREAKER_SECONDS=20

CHAT_PROVIDER=ollama
CHAT_BASE_URL=http://host.docker.internal:11434
CHAT_MODEL=llama3.2:1b
CHAT_API_KEY=
CHAT_HEADERS_JSON=
CHAT_TEMPERATURE=0.1
# Used only when CHAT_PROVIDER=capella_model_service
MODEL_SERVICE_CACHE_MODE=semantic
MODEL_SERVICE_ROUTING_STRATEGY=least-latency
MODEL_NUM_PREDICT=180
MODEL_TIMEOUT_SECONDS=120

EMBEDDING_PROVIDER=openai_compatible
EMBEDDING_BASE_URL=http://ollama:11434
# Optional host-side embedding endpoint used by the catalogue loader.
EMBEDDING_LOADER_BASE_URL=http://ollama:11434
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_API_KEY=
EMBEDDING_HEADERS_JSON=
EMBEDDING_DIMENSIONS=768
EMBEDDING_TIMEOUT_SECONDS=5

# Couchbase Agent Memory server. Create the agent_memory bucket and service user first.
# Optional image controls. Leave blank to auto-detect a compatible loaded image.
AGENT_MEMORY_IMAGE=
# Optional absolute path to the Couchbase-provided image tar. The startup script can auto-load it.
AGENT_MEMORY_IMAGE_TAR=
AGENT_MEMORY_AUTO_LOAD=true
START_AGENT_MEMORY=true
AGENT_MEMORY_URL=http://agentmemory-server:8080
AGENTMEMORY_CONN_STRING=couchbases://couchbase.example.internal
AGENTMEMORY_USERNAME=agent-memory-runtime
AGENTMEMORY_PASSWORD=CHANGE_ME
AGENTMEMORY_BUCKET=agent_memory
AGENTMEMORY_OPENAI_API_KEY=ollama
OPENAI_API_KEY=ollama
AGENTMEMORY_EMBEDDING_MODEL=nomic-embed-text
AGENTMEMORY_EMBEDDING_URL=http://ollama:11434/v1
AGENTMEMORY_LLM_MODEL=llama3.2:1b
AGENTMEMORY_LLM_URL=http://ollama:11434/v1
AGENTMEMORY_SERVER_HOST=0.0.0.0
AGENTMEMORY_SERVER_PORT=8080
OIDC_AUTH_ENABLED=false
LOG_LEVEL=INFO
AGENTMEMORY_DURABLE_WRITES=false
AGENTMEMORY_THREAD_POOL_SIZE=8
AGENTMEMORY_PROCESSING_BATCH_SIZE=1
AGENTMEMORY_HEALTH_CACHE_TTL_SECONDS=30
AGENTMEMORY_HEALTH_REFRESH_INTERVAL_SECONDS=15
TMDB_READ_ACCESS_TOKEN=
LOAD_SAMPLE_CATALOGUE=true

MANAGE_SEARCH_INDEX=false
CB_LOADER_CONN_STRING=${CB_CONN_STRING}

# Native Couchbase Agent Catalog, Agent Tracer and MCP Server
MCP_ENABLED=true
MCP_REQUIRED=true
START_MCP_SERVER=true
MCP_IMAGE=couchbase-stream-ai-mcp-server:2.0.1
MCP_BUILD_LOCAL_IMAGE=true
MCP_URL=http://couchbase-mcp-server:8000/mcp
MCP_HOST_PORT=8000
MCP_READ_ONLY=true
MCP_CB_CONNECTION_STRING=${CB_CONN_STRING}
MCP_CB_USERNAME=streamai_mcp
MCP_CB_PASSWORD=change-me-mcp-password

AGENT_CATALOG_ENABLED=true
PUBLISH_AGENT_CATALOG_ON_START=true
AGENT_CATALOG_REQUIRED=true
AGENT_CATALOG_MODE=native
AGENT_CATALOG_EXECUTION_MODE=mcp
AGENT_CATALOG_PROMPT_NAME=streaming_assistant_system
AGENT_CATALOG_CONN_STRING=${CB_CONN_STRING}
AGENT_CATALOG_USERNAME=${CB_USERNAME}
AGENT_CATALOG_PASSWORD=${CB_PASSWORD}
# Supply credentials with DDL rights for the one-time publish step.
AGENT_CATALOG_PUBLISH_USERNAME=
AGENT_CATALOG_PUBLISH_PASSWORD=
AGENT_CATALOG_BUCKET=streaming
AGENT_CATALOG_INTERACTIVE=False
AGENT_CATALOG_EMBEDDING_MODEL=all-MiniLM-L12-v2
NATIVE_AGENT_TRACING_ENABLED=true

# Capella-only native AI Services. Keep disabled for local/self-managed unless configured.
AI_FUNCTIONS_ENABLED=false
AI_FUNCTIONS_TEMPERATURE=0.1
AI_FUNCTIONS_MAX_TOKENS=220
DATA_PROCESSING_MODE=python_loader
DATA_PROCESSING_WORKFLOW_ID=

# UI experience. `customer` hides demo/operator panels. Disable the switch to
# lock a customer-facing deployment; set SHOWCASE_ENABLED=false to avoid
# starting Showcase Studio routes entirely.
UI_EXPERIENCE_MODE=showcase
UI_EXPERIENCE_SWITCH_ENABLED=true

# StreamAI v2 Showcase Studio
SHOWCASE_ENABLED=true
PRESENTER_MODE_ENABLED=true
RESILIENCE_LAB_ENABLED=true
EVALUATION_DASHBOARD_ENABLED=true
SHOWCASE_STATE_COLLECTION=showcase_state
EXPERIMENTS_COLLECTION=experiments
EVALUATIONS_COLLECTION=evaluations
PROFILE_SNAPSHOTS_COLLECTION=profile_snapshots
CAPELLA_CONSOLE_BASE_URL=https://cloud.couchbase.com
CAPELLA_PROJECT_ID=
CAPELLA_CLUSTER_ID=
CAPELLA_AGENT_TRACER_URL=
CAPELLA_TOOLS_HUB_URL=
CAPELLA_PROMPTS_HUB_URL=
CAPELLA_MODEL_SERVICE_URL=
SHOWCASE_REFERENCE_CURRENCY=GBP
